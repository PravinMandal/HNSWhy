{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug + ASan/UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HNSWHY_SANITIZE": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release -O3",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-native",
      "displayName": "Release -march=native",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/release-native",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -march=native"
      }
    },
    {
      "name": "ci",
      "displayName": "CI release",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/ci"
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "release-native", "configurePreset": "release-native" },
    { "name": "ci", "configurePreset": "ci" }
  ]
}
