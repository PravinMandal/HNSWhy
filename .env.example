# HNSWhy configuration
#
# Copy this file to `.env` and edit the values you need. The server does not
# load `.env` by itself; use `scripts/run_server.sh`, `set -a; source .env; set +a`,
# or pass the same values through your process manager.
#
# Never commit real API keys. `.env` is ignored by git.

# ---------------------------------------------------------------------------
# Server and storage
# ---------------------------------------------------------------------------

# SQLite database. Created automatically on first run.
HNSWHY_DB=data/hnswhy.db

# HTTP listener.
HNSWHY_HOST=127.0.0.1
HNSWHY_PORT=8080

# Built frontend assets and the read-only benchmark report.
HNSWHY_STATIC_DIR=frontend/dist
HNSWHY_BENCH_REPORT=docs/results/bench.json

# Sample knowledge base. Seeded only into a fresh database with the offline
# hash embedder. Set to 0 to start with an empty library.
HNSWHY_SAMPLES_DIR=samples
HNSWHY_LOAD_SAMPLE=1

# Re-embed every stored chunk with the active embedding provider. Use this
# after switching embedding providers or models.
HNSWHY_REEMBED=0

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# provider: hash | ollama | openai
# hash is offline and deterministic, useful for demos and tests.
HNSWHY_EMBEDDING_PROVIDER=hash
HNSWHY_EMBEDDING_MODEL=local-hash-v1
# Leave this unset to use the provider's native dimension (256 for hash).
# Setting it pins the stored embedding space; switching providers without
# updating it causes an EMBEDDING_MISMATCH until you run with HNSWHY_REEMBED=1.
# HNSWHY_EMBEDDING_DIM=0

# Ollama example:
# HNSWHY_EMBEDDING_PROVIDER=ollama
# HNSWHY_EMBEDDING_MODEL=nomic-embed-text
# HNSWHY_EMBEDDING_BASE_URL=http://127.0.0.1:11434
# HNSWHY_EMBEDDING_DIM=0

# OpenAI or any OpenAI-compatible server example:
# HNSWHY_EMBEDDING_PROVIDER=openai
# HNSWHY_EMBEDDING_MODEL=text-embedding-3-small
# HNSWHY_EMBEDDING_BASE_URL=https://api.openai.com/v1
# HNSWHY_EMBEDDING_API_KEY=replace-me
# HNSWHY_EMBEDDING_DIM=0

HNSWHY_EMBEDDING_BASE_URL=
HNSWHY_EMBEDDING_API_KEY=
HNSWHY_EMBEDDING_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Chat / answer generation
# ---------------------------------------------------------------------------
# provider: extractive | ollama | openai
# extractive is an offline, citation-producing fallback.
HNSWHY_CHAT_PROVIDER=extractive
HNSWHY_CHAT_MODEL=local-extractive-v1

# Ollama example:
# HNSWHY_CHAT_PROVIDER=ollama
# HNSWHY_CHAT_MODEL=llama3.2
# HNSWHY_CHAT_BASE_URL=http://127.0.0.1:11434

# OpenAI-compatible example:
# HNSWHY_CHAT_PROVIDER=openai
# HNSWHY_CHAT_MODEL=gpt-4o-mini
# HNSWHY_CHAT_BASE_URL=https://api.openai.com/v1
# HNSWHY_CHAT_API_KEY=replace-me

HNSWHY_CHAT_BASE_URL=
HNSWHY_CHAT_API_KEY=
HNSWHY_CHAT_TIMEOUT_SECONDS=60

# OPENAI_API_KEY is used as a fallback for both provider API keys.
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Retrieval and chunking
# ---------------------------------------------------------------------------
HNSWHY_QUERY_EF=50
HNSWHY_DEFAULT_K=5
HNSWHY_CHUNK_WORDS=350
HNSWHY_CHUNK_OVERLAP=50

# ---------------------------------------------------------------------------
# HNSW
# ---------------------------------------------------------------------------
HNSWHY_HNSW_M=16
HNSWHY_HNSW_M0=32
HNSWHY_HNSW_EF_CONSTRUCTION=200
HNSWHY_HNSW_SEED=42
